# Copy to .env on the VM. Never commit .env. Phones never receive these keys.

# --- domain / hosting ---
TROPHY_DOMAIN=trophy.example.com
GCS_BUCKET=trophy-recordings
GOOGLE_APPLICATION_CREDENTIALS=/secrets/gcp-sa.json

# --- realtime ---
SPACETIME_HOST=http://spacetimedb:3000
SPACETIME_DB=trophy
REDIS_URL=redis://redis:6379/0

# --- decisions ---
SUBQ_API_KEY=
SUBQ_MODEL=subq-snap-1.1
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# --- voice ---
CARTESIA_API_KEY=
CARTESIA_MODEL=sonic-3.6
DEEPGRAM_API_KEY=

# --- agents / retrieval ---
FACTORY_API_KEY=
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=
FIRECRAWL_API_KEY=

# --- vision ---
ROBOFLOW_API_KEY=

# --- observability / extras ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
AGENTMAIL_API_KEY=

# --- post-game / render ---
VULTR_API_KEY=
REMOTION_AWS_ACCESS_KEY_ID=
