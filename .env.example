# Copy to .env on the dev Mac. Never commit .env. Phones never receive these keys
# (they get short-lived tokens from the gateway). Names match docs/plan/interfaces-v1.md §14.

# --- domain / hosting ---
TROPHY_DOMAIN=trophy.photo
TROPHY_TOKEN_SECRET=
PORT_OFFSET=0                      # A1 +0, A2 +100, A3 +200 when worktrees run side by side

# Caddy DNS-01 for the certificate (Porkbun DNS API; enable API access for the domain in Porkbun first)
PORKBUN_API_KEY=
PORKBUN_SECRET_API_KEY=

# --- realtime (Spacetime is the live backend) ---
SPACETIME_URI=http://127.0.0.1:3000
SPACETIME_MODULE=trophy
SPACETIME_ENGINE_TOKEN=
SPACETIME_VISION_TOKEN=            # trophy.world writers (observation, track_sample)
SPACETIME_COMPILER_TOKEN=
REDIS_URL=redis://127.0.0.1:6379/0

# --- AI voters and answers (decide(), ask the ref, Droid fallback) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_FAST_MODEL=claude-haiku-5-5
GEMINI_API_KEY=
GEMINI_MODEL=
BITDEER_API_KEY=
BITDEER_BASE_URL=https://api-inference.bitdeer.ai/v1
BITDEER_VISION_MODEL=Qwen/Qwen3.5-397B-A17B

# --- voice (Cartesia: Sonic TTS + Ink-2 STT) ---
CARTESIA_API_KEY=
CARTESIA_VERSION=2026-08-14         # verified 2026-10-24 (access-token, TTS WS, Ink-2 STT WS)
CARTESIA_VOICE_CALLS=
CARTESIA_VOICE_REF=

# --- house rules (Factory Droid SDK) ---
FACTORY_API_KEY=

# --- rulebooks (Apify actor -> Moss) ---
APIFY_TOKEN=                        # only for `apify push` / pulling a platform dataset; local `apify run` needs none
MOSS_PROJECT_ID=                    # Moss portal -> project -> API keys (free Developer tier: 3 indexes)
MOSS_PROJECT_KEY=
MOSS_INDEX=trophy-rules-v1          # ONE index for every sport, filtered by the `sport` metadata field (D-30)
MOSS_MODEL=moss-minilm              # or moss-mediumlm
# MOSS_CACHE_PATH=                  # local index snapshots; defaults to data/local/moss (gitignored)
ASK_MODEL=claude-opus-5-5           # /ask answers; switch to claude-haiku-5-5 only with the user's OK (brief §2.3)
ASK_EFFORT=low                      # output_config.effort for /ask
ASK_MIN_SCORE=0.35                  # below this top Moss score /ask says "I couldn't find that rule" (tuned on evals/ask)
ASK_TOP_K=5
APIFY_RULEBOOK_ACTOR=trophy/sports-rulebook-scraper   # whose last SUCCEEDED run `trophy-rules dataset export --actor` pulls

# --- optional ---
ROBOFLOW_API_KEY=                  # dataset downloads only
VULTR_API_KEY=                     # GPU fallback only, with the user's approval
