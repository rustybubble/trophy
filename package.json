{
  "name": "trophy",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/contracts",
    "packages/state-client",
    "spacetime",
    "apps/pwa",
    "apps/dashboard",
    "apps/watch"
  ],
  "scripts": {
    "dev": "uv run --project packages/py-trophy --frozen python scripts/dev.py",
    "contracts": "node scripts/gen-contracts.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint packages apps",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write \"packages/**/*.{ts,tsx,json}\""
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/node": "22.20.5",
    "eslint": "9.39.1",
    "json-schema-to-typescript": "15.0.4",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.4",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
