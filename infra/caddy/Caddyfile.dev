# Dev origin for the phones: https://trophy.photo on the demo machine's LAN IP (interfaces-v1 §14).
# Certificate: ACME DNS-01 through Porkbun's DNS API, so nothing has to be reachable from the internet.
# Caddy must include the module: https://caddyserver.com/download?package=github.com%2Fcaddy-dns%2Fporkbun
# (or `xcaddy build --with github.com/caddy-dns/porkbun`). Run from the repo root with .env loaded:
#   caddy run --config infra/caddy/Caddyfile.dev --envfile .env
{$TROPHY_DOMAIN} {
	tls {
		dns porkbun {
			api_key {env.PORKBUN_API_KEY}
			api_secret_key {env.PORKBUN_SECRET_API_KEY}
		}
	}
	encode zstd gzip

	# phones often drop the trailing slash; without these the request falls through to the dashboard
	redir /cam /cam/ 308
	redir /spike/voice /spike/voice/ 308

	# gateway: routes live under /api (§13), so keep the prefix
	handle /api/* {
		reverse_proxy 127.0.0.1:8000
	}
	# SpacetimeDB (no TLS of its own). Browsers only need the subscription WebSocket (+ identity, ping);
	# reducer calls, SQL and publishing stay on 127.0.0.1:3000 for backend services, so the LAN can't reach them.
	@stdb_client path_regexp ^/stdb/v1/(ping|identity(/websocket-token)?|database/[A-Za-z0-9_-]+/subscribe)$
	handle @stdb_client {
		uri strip_prefix /stdb
		reverse_proxy 127.0.0.1:3000
	}
	handle /stdb/* {
		respond "forbidden" 403
	}
	# Trophy Watch (Vite dev server, base "/watch/")
	redir /watch /watch/ 308
	handle /watch/* {
		reverse_proxy 127.0.0.1:5175
	}
	# PWA (Vite dev server, base "/cam/")
	handle /cam/* {
		reverse_proxy 127.0.0.1:5173
	}
	# P0 voice spike (spikes/cartesia-voice/serve.py)
	handle_path /spike/voice/* {
		reverse_proxy 127.0.0.1:8765
	}
	# dashboard (Vite dev server)
	handle {
		reverse_proxy 127.0.0.1:5174
	}

	# a readable page instead of a blank 502 when a service isn't running yet
	handle_errors 502 503 504 {
		header Content-Type "text/html; charset=utf-8"
		respond `<!doctype html><meta name="viewport" content="width=device-width,initial-scale=1"><body style="font:18px -apple-system,system-ui,sans-serif;padding:24px;background:#0f1115;color:#f3f4f6"><h1>Trophy</h1><p>This part isn't running right now ({err.status_code}).</p><p><a style="color:#f59e0b" href="/spike/voice/">Voice test</a></p></body>` 502
	}
}
