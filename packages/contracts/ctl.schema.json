{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trophy.local/contracts/ctl.schema.json",
  "title": "CtlCommand",
  "description": "trophy.ctl.v1: one ctl:engine entry (field `json`), gateway -> engine (interfaces-v1 §9). `args` matches the <Cmd>Args $def for `cmd`. The gateway enforces the role allowlist (see CTL_CLIENT_ROLES in trophy.streams). The Ws* $defs are the /api/ws/ctl messages (§13).",
  "type": "object",
  "required": ["schema", "req_id", "cmd", "game_id", "t_srv_ms", "args"],
  "properties": {
    "schema": { "const": "trophy.ctl.v1" },
    "req_id": { "type": "string", "description": "ULID" },
    "cmd": { "$ref": "#/$defs/CtlCmd" },
    "game_id": { "type": "string" },
    "t_srv_ms": { "type": "number" },
    "by_cam_id": { "type": ["string", "null"], "description": "null for gateway-originated commands" },
    "args": { "type": "object" }
  },
  "$defs": {
    "CtlCmd": {
      "title": "CtlCmd",
      "enum": [
        "create_game",
        "register_camera",
        "camera_health",
        "set_calibration",
        "start_game",
        "set_server",
        "challenge",
        "resolve_challenge",
        "undo_last_call",
        "adjust_score",
        "end_period",
        "end_game",
        "submit_house_rule",
        "approve_house_rule",
        "reject_house_rule",
        "ask_logged"
      ]
    },
    "TeamSpec": {
      "title": "TeamSpec",
      "type": "object",
      "required": ["team_id"],
      "properties": {
        "team_id": { "type": "string" },
        "name": { "type": "string" },
        "color": { "type": "string" }
      }
    },
    "CreateGameArgs": {
      "title": "CreateGameArgs",
      "type": "object",
      "required": ["sport", "t0_ms"],
      "properties": {
        "sport": { "type": "string" },
        "t0_ms": { "type": "number" },
        "teams": { "type": "array", "items": { "$ref": "#/$defs/TeamSpec" } },
        "params": { "type": "object" }
      }
    },
    "RegisterCameraArgs": {
      "title": "RegisterCameraArgs",
      "type": "object",
      "required": ["cam_id", "label", "role"],
      "properties": {
        "cam_id": { "type": "string" },
        "label": { "type": "string" },
        "role": { "type": "string", "description": "cam|display|judge, comma-combinable" },
        "device": { "type": "object" }
      }
    },
    "CameraHealthArgs": {
      "title": "CameraHealthArgs",
      "type": "object",
      "required": ["cam_id", "connected"],
      "properties": {
        "cam_id": { "type": "string" },
        "connected": { "type": "boolean" },
        "fps_in": { "type": "number" },
        "w": { "type": "integer" },
        "h": { "type": "integer" },
        "sync_err_ms": { "type": "number" },
        "last_seen_ms": { "type": "number" }
      }
    },
    "SetCalibrationArgs": {
      "title": "SetCalibrationArgs",
      "type": "object",
      "required": ["cam_id", "calibration"],
      "properties": {
        "cam_id": { "type": "string" },
        "calibration": { "type": "object", "description": "trophy.calibration.v1" }
      }
    },
    "StartGameArgs": {
      "title": "StartGameArgs",
      "type": "object",
      "properties": { "first_server": { "enum": ["A", "B"] } }
    },
    "SetServerArgs": {
      "title": "SetServerArgs",
      "type": "object",
      "required": ["team_id"],
      "properties": { "team_id": { "type": "string" } }
    },
    "ChallengeArgs": {
      "title": "ChallengeArgs",
      "type": "object",
      "required": ["call_id"],
      "properties": { "call_id": { "type": "string" } }
    },
    "Replacement": {
      "title": "Replacement",
      "type": "object",
      "required": ["outcome"],
      "properties": {
        "outcome": { "type": "string" },
        "team_id": { "type": "string" }
      }
    },
    "ResolveChallengeArgs": {
      "title": "ResolveChallengeArgs",
      "type": "object",
      "required": ["challenge_id", "result"],
      "properties": {
        "challenge_id": { "type": "string" },
        "result": { "enum": ["upheld", "overturned"] },
        "replacement": { "$ref": "#/$defs/Replacement" }
      }
    },
    "EmptyArgs": { "title": "EmptyArgs", "type": "object", "description": "undo_last_call, end_period, end_game" },
    "AdjustScoreArgs": {
      "title": "AdjustScoreArgs",
      "type": "object",
      "required": ["team_id", "delta"],
      "properties": {
        "team_id": { "type": "string" },
        "delta": { "type": "integer" }
      }
    },
    "SubmitHouseRuleArgs": {
      "title": "SubmitHouseRuleArgs",
      "type": "object",
      "required": ["text", "source"],
      "properties": {
        "text": { "type": "string", "minLength": 1, "maxLength": 500 },
        "source": { "enum": ["typed", "voice"] }
      }
    },
    "HouseRuleVersionArgs": {
      "title": "HouseRuleVersionArgs",
      "description": "approve_house_rule, reject_house_rule",
      "type": "object",
      "required": ["rule_version"],
      "properties": { "rule_version": { "type": "string" } }
    },
    "AskCitation": {
      "title": "AskCitation",
      "type": "object",
      "required": ["rule_id", "title", "url", "quote"],
      "properties": {
        "rule_id": { "type": "string" },
        "title": { "type": "string" },
        "url": { "type": "string" },
        "quote": { "type": "string", "description": "<= 25 words" }
      }
    },
    "AskLoggedArgs": {
      "title": "AskLoggedArgs",
      "type": "object",
      "required": ["question", "answer", "citations", "latency_ms"],
      "properties": {
        "question": { "type": "string" },
        "answer": { "type": "string" },
        "citations": { "type": "array", "items": { "$ref": "#/$defs/AskCitation" } },
        "latency_ms": { "type": "number" },
        "moss_ms": { "type": "number" }
      }
    },
    "WsClientMessage": {
      "title": "WsClientMessage",
      "description": "Phone -> gateway on /api/ws/ctl. ping {t0} (with the previous completed sample in `prev`), health {...}, onset {t_phone_ms, peak, energy}, call_ack {call_id, t_phone_ms}",
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["ping", "health", "onset", "call_ack"] },
        "t0": { "type": "number", "description": "ping: phone send time, ms" },
        "prev": { "$ref": "#/$defs/ClockSample" },
        "t_phone_ms": { "type": "number" },
        "peak": { "type": "number" },
        "energy": { "type": "number" },
        "call_id": { "type": "string" },
        "fps": { "type": "number" },
        "w": { "type": "integer" },
        "h": { "type": "integer" },
        "battery": { "type": "number" },
        "thermal": { "type": "string" }
      }
    },
    "ClockSample": {
      "title": "ClockSample",
      "description": "One completed ping/pong exchange: t0 phone send, t1 server receive, t2 server send, t3 phone receive (ms)",
      "type": "object",
      "required": ["t0", "t1", "t2", "t3"],
      "properties": {
        "t0": { "type": "number" },
        "t1": { "type": "number" },
        "t2": { "type": "number" },
        "t3": { "type": "number" }
      }
    },
    "WsServerMessage": {
      "title": "WsServerMessage",
      "description": "Gateway -> phone on /api/ws/ctl. pong {t0, t1, t2}, sync {offset_ms, sync_err_ms}, cmd {cmd, args}",
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["pong", "sync", "cmd"] },
        "t0": { "type": "number" },
        "t1": { "type": "number" },
        "t2": { "type": "number" },
        "offset_ms": { "type": "number" },
        "sync_err_ms": { "type": "number" },
        "cmd": { "type": "string" },
        "args": { "type": "object" }
      }
    }
  }
}
