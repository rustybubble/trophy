{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trophy.local/contracts/ctl.schema.json",
  "title": "CtlCommand",
  "description": "trophy.ctl.v1: one ctl:engine entry (field `json`), gateway -> engine (interfaces-v1 §9). `args` matches the <Cmd>Args $def for `cmd`. The gateway enforces the role allowlist (see CTL_CLIENT_ROLES in trophy.streams). The Ws* $defs are the /api/ws/ctl messages (§13).",
  "type": "object",
  "required": ["schema", "req_id", "cmd", "game_id", "t_srv_ms", "args"],
  "properties": {
    "schema": {
      "const": "trophy.ctl.v1"
    },
    "req_id": {
      "type": "string",
      "description": "ULID"
    },
    "cmd": {
      "$ref": "#/$defs/CtlCmd"
    },
    "game_id": {
      "type": "string"
    },
    "t_srv_ms": {
      "type": "number"
    },
    "by_cam_id": {
      "type": ["string", "null"],
      "description": "null for gateway-originated commands"
    },
    "args": {
      "type": "object"
    }
  },
  "$defs": {
    "CtlCmd": {
      "title": "CtlCmd",
      "enum": [
        "create_game",
        "register_camera",
        "camera_health",
        "set_calibration",
        "start_game",
        "set_server",
        "challenge",
        "resolve_challenge",
        "undo_last_call",
        "adjust_score",
        "end_period",
        "end_game",
        "submit_house_rule",
        "approve_house_rule",
        "reject_house_rule",
        "ask_logged",
        "bookmark",
        "clip_that",
        "review_call",
        "run_check",
        "request_check",
        "feed_schedule",
        "viewer_status",
        "revert_house_rule"
      ]
    },
    "TeamSpec": {
      "title": "TeamSpec",
      "type": "object",
      "required": ["team_id"],
      "properties": {
        "team_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "color": {
          "type": "string"
        }
      }
    },
    "CreateGameArgs": {
      "title": "CreateGameArgs",
      "type": "object",
      "required": ["sport", "t0_ms"],
      "properties": {
        "sport": {
          "type": "string"
        },
        "t0_ms": {
          "type": "number"
        },
        "teams": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TeamSpec"
          }
        },
        "params": {
          "type": "object"
        }
      }
    },
    "RegisterCameraArgs": {
      "title": "RegisterCameraArgs",
      "type": "object",
      "required": ["cam_id", "label", "role"],
      "properties": {
        "cam_id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "role": {
          "type": "string",
          "description": "cam|display|judge, comma-combinable"
        },
        "device": {
          "type": "object"
        }
      }
    },
    "CameraHealthArgs": {
      "title": "CameraHealthArgs",
      "type": "object",
      "required": ["cam_id", "connected"],
      "properties": {
        "cam_id": {
          "type": "string"
        },
        "connected": {
          "type": "boolean"
        },
        "fps_in": {
          "type": "number"
        },
        "w": {
          "type": "integer"
        },
        "h": {
          "type": "integer"
        },
        "sync_err_ms": {
          "type": "number"
        },
        "last_seen_ms": {
          "type": "number"
        }
      }
    },
    "SetCalibrationArgs": {
      "title": "SetCalibrationArgs",
      "type": "object",
      "required": ["cam_id", "calibration"],
      "properties": {
        "cam_id": {
          "type": "string"
        },
        "calibration": {
          "type": "object",
          "description": "trophy.calibration.v1"
        }
      }
    },
    "StartGameArgs": {
      "title": "StartGameArgs",
      "type": "object",
      "properties": {
        "first_server": {
          "enum": ["A", "B"]
        }
      }
    },
    "SetServerArgs": {
      "title": "SetServerArgs",
      "type": "object",
      "required": ["team_id"],
      "properties": {
        "team_id": {
          "type": "string"
        }
      }
    },
    "ChallengeArgs": {
      "title": "ChallengeArgs",
      "type": "object",
      "required": ["call_id"],
      "properties": {
        "call_id": {
          "type": "string"
        }
      }
    },
    "Replacement": {
      "title": "Replacement",
      "type": "object",
      "required": ["outcome"],
      "properties": {
        "outcome": {
          "type": "string"
        },
        "team_id": {
          "type": "string"
        }
      }
    },
    "ResolveChallengeArgs": {
      "title": "ResolveChallengeArgs",
      "type": "object",
      "required": ["challenge_id", "result"],
      "properties": {
        "challenge_id": {
          "type": "string"
        },
        "result": {
          "enum": ["upheld", "overturned"]
        },
        "replacement": {
          "$ref": "#/$defs/Replacement"
        }
      }
    },
    "EmptyArgs": {
      "title": "EmptyArgs",
      "type": "object",
      "description": "undo_last_call, end_period, end_game"
    },
    "AdjustScoreArgs": {
      "title": "AdjustScoreArgs",
      "type": "object",
      "required": ["team_id", "delta"],
      "properties": {
        "team_id": {
          "type": "string"
        },
        "delta": {
          "type": "integer"
        }
      }
    },
    "SubmitHouseRuleArgs": {
      "title": "SubmitHouseRuleArgs",
      "type": "object",
      "required": ["text", "source"],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "source": {
          "enum": ["typed", "voice"]
        }
      }
    },
    "HouseRuleVersionArgs": {
      "title": "HouseRuleVersionArgs",
      "description": "approve_house_rule, reject_house_rule",
      "type": "object",
      "required": ["rule_version"],
      "properties": {
        "rule_version": {
          "type": "string"
        }
      }
    },
    "CheckReply": {
      "title": "CheckReply",
      "description": "The referee reply (was CheckResult; renamed at the demo merge because track3d.schema.json owns CheckResult, the check function's own return). What the engine XADDs (field `json`) to a run_check / request_check `reply_to` stream: one geometry check run over the session track (D-36 §5-6). verdict, p, evidence and calibrated are the check function's own return; `error` is set instead when the check is missing or failed.",
      "type": "object",
      "required": ["check", "calibrated", "latency_ms"],
      "properties": {
        "check": {
          "type": "string",
          "description": "e.g. in_out"
        },
        "verdict": {
          "type": "string",
          "description": "e.g. in, out, edge, A, B, top_edge, side_face, legal, too_low, angled, yes, no"
        },
        "p": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Probability of verdict, carrying the track sigma"
        },
        "evidence": {
          "type": "object",
          "description": "Check-specific numbers: margin_m, sigma_m, line, height_m, angle_deg, t_game_s, shots ..."
        },
        "inputs": {
          "type": "object",
          "description": "The resolved arguments the check ran with (t_game_s, rally_no ...)"
        },
        "calibrated": {
          "type": "boolean",
          "description": "false on the unedited golden library or when sigma was a default"
        },
        "tier": {
          "enum": ["AUTO", "BETA", "PLAYERS"],
          "description": "The tier ceiling the engine applied"
        },
        "error": {
          "type": "string",
          "description": "no_such_check | no_data | failed:<reason> | timeout"
        },
        "latency_ms": {
          "type": "number"
        }
      }
    },
    "RunCheckArgs": {
      "title": "RunCheckArgs",
      "description": "Referee -> engine: run one session check and XADD a CheckReply to the Redis stream `reply_to` (D-36 §5).",
      "type": "object",
      "required": ["check", "args", "reply_to"],
      "properties": {
        "check": {
          "type": "string"
        },
        "args": {
          "type": "object",
          "description": "t_game_s (absolute, field clock) when known, else ref: last | last_rally | call:<call_id>; plus check-specific args"
        },
        "reply_to": {
          "type": "string",
          "description": "Redis stream key reply:<req_id>; the engine XADDs {json: CheckReply} once"
        },
        "question": {
          "type": "string",
          "description": "The spoken question, for the engine's transcript"
        }
      }
    },
    "RequestCheckArgs": {
      "title": "RequestCheckArgs",
      "description": "Referee -> engine: no session check answers this question. The engine opens a droid_run of kind new_check (the Droid writes and gates it in 30-90 s), runs it, and replies on `reply_to` with a CheckReply, or one with `error` when the run failed.",
      "type": "object",
      "required": ["question", "reply_to"],
      "properties": {
        "question": {
          "type": "string"
        },
        "check_hint": {
          "type": "string",
          "description": "The router's suggested signature, e.g. ball_speed(rally) -> max speed in m/s"
        },
        "args": {
          "type": "object"
        },
        "reply_to": {
          "type": "string"
        }
      }
    },
    "AskCitation": {
      "title": "AskCitation",
      "type": "object",
      "required": ["rule_id", "title", "url", "quote"],
      "properties": {
        "rule_id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "quote": {
          "type": "string",
          "description": "<= 25 words"
        }
      }
    },
    "AskLoggedArgs": {
      "title": "AskLoggedArgs",
      "type": "object",
      "required": ["question", "answer", "citations", "latency_ms"],
      "properties": {
        "question": {
          "type": "string"
        },
        "answer": {
          "type": "string"
        },
        "citations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AskCitation"
          }
        },
        "latency_ms": {
          "type": "number"
        },
        "moss_ms": {
          "type": "number"
        },
        "speech": {
          "type": "string",
          "description": "Spoken form; phones speak it when the row arrives late (a pending answer)"
        },
        "kind": {
          "enum": ["check", "rule", "score", "explain", "pending", "none"],
          "description": "How the referee answered"
        },
        "check": {
          "type": "string",
          "description": "The session check that answered, when kind = check"
        },
        "p": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "calibrated": {
          "type": "boolean"
        },
        "by_cam_id": {
          "type": "string",
          "description": "Who asked; set by the referee on late answers"
        }
      }
    },
    "WsClientMessage": {
      "title": "WsClientMessage",
      "description": "Phone -> gateway on /api/ws/ctl. ping {t0} (with the previous completed sample in `prev`), health {...}, onset {t_phone_ms, peak, energy}, call_ack {call_id, t_phone_ms}",
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "enum": ["ping", "health", "onset", "call_ack"]
        },
        "t0": {
          "type": "number",
          "description": "ping: phone send time, ms"
        },
        "prev": {
          "$ref": "#/$defs/ClockSample"
        },
        "t_phone_ms": {
          "type": "number"
        },
        "peak": {
          "type": "number"
        },
        "energy": {
          "type": "number"
        },
        "call_id": {
          "type": "string"
        },
        "fps": {
          "type": "number"
        },
        "w": {
          "type": "integer"
        },
        "h": {
          "type": "integer"
        },
        "battery": {
          "type": "number"
        },
        "thermal": {
          "type": "string"
        }
      }
    },
    "ClockSample": {
      "title": "ClockSample",
      "description": "One completed ping/pong exchange: t0 phone send, t1 server receive, t2 server send, t3 phone receive (ms)",
      "type": "object",
      "required": ["t0", "t1", "t2", "t3"],
      "properties": {
        "t0": {
          "type": "number"
        },
        "t1": {
          "type": "number"
        },
        "t2": {
          "type": "number"
        },
        "t3": {
          "type": "number"
        }
      }
    },
    "WsServerMessage": {
      "title": "WsServerMessage",
      "description": "Gateway -> phone on /api/ws/ctl. pong {t0, t1, t2}, sync {offset_ms, sync_err_ms}, cmd {cmd, args}",
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "enum": ["pong", "sync", "cmd"]
        },
        "t0": {
          "type": "number"
        },
        "t1": {
          "type": "number"
        },
        "t2": {
          "type": "number"
        },
        "offset_ms": {
          "type": "number"
        },
        "sync_err_ms": {
          "type": "number"
        },
        "cmd": {
          "type": "string"
        },
        "args": {
          "type": "object"
        }
      }
    },
    "BookmarkArgs": {
      "title": "BookmarkArgs",
      "type": "object",
      "properties": {
        "t_game_s": {
          "type": "number",
          "minimum": 0
        },
        "label": {
          "type": "string",
          "maxLength": 80
        }
      },
      "additionalProperties": false
    },
    "ClipThatArgs": {
      "title": "ClipThatArgs",
      "type": "object",
      "properties": {
        "t_game_s": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "ReviewCallArgs": {
      "title": "ReviewCallArgs",
      "type": "object",
      "required": ["call_id", "result"],
      "properties": {
        "call_id": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "enum": ["confirm", "correct"]
        },
        "replacement": {
          "$ref": "#/$defs/Replacement"
        }
      },
      "additionalProperties": false
    },
    "FeedScheduleArgs": {
      "title": "FeedScheduleArgs",
      "type": "object",
      "required": ["feeds"],
      "properties": {
        "feeds": {
          "type": "array",
          "items": {
            "type": "object",
            "description": "trophy state Feed without game_id/updated_at_ms"
          }
        }
      }
    },
    "ViewerStatusArgs": {
      "title": "ViewerStatusArgs",
      "type": "object",
      "required": ["cam_id"],
      "properties": {
        "cam_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "playing": {
          "type": "boolean"
        },
        "drift_ms": {
          "type": "number"
        },
        "connected": {
          "type": "boolean"
        }
      }
    }
  }
}
